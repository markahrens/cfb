---
import { getTeamById } from '../lib/db';
import slugify from 'slugify';


const { id, year_joined, showLogo = true, linkedName = false } = Astro.props;


const team = getTeamById(id);

let school = 'Default ' + id ;
let mascot = 'Mascot';

if(team) { 
  school = team.school 
mascot = team.mascot }


---

<div class="teamcard">

    {(showLogo) && <div class="logo"><img src={`/logos/small/${team.id}.png`} width="40" /></div>}
    
    <div class="name">
      {linkedName && <a href={`/${slugify(school, {lower: true})} `}><span class="teamcard__title">{school}</span></a>}
      {!linkedName && <span class="teamcard__title">{school}</span>}
      {mascot} 
      {(year_joined > 1850) && <span> | Joined: {year_joined}</span>}
    </div>

    
</div>

<style>
    .teamcard {
          display: grid;
          grid-template-columns: fit-content(50px) 1fr;
          gap: 10px;
          align-items: center;
          grid-template-areas:
            "logo name";
          .logo {
            grid-area: logo;
            min-height: 40px;
            display: grid;
            place-items: center;
          }
          .name {
            grid-area: name;
            .teamcard__title {
              font-size: 1.4rem;
              font-weight: 500;
            }
          }
          
        }
</style>