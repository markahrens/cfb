---
import { getTeamById } from '../lib/db';
import slugify from 'slugify';


const { id, yearJoined, yearLeft, showLogo = true, linkedName = false } = Astro.props;


const team = getTeamById(id);

let school = 'Default ' + id ;
let mascot = 'Mascot';

if(team) { 
  school = team.school 
mascot = team.mascot }


---

<div class="teamcard">

    {(showLogo) && <div class="logo"><img src={`/logos/small/${team.id}.png`} width="40" /></div>}
    
    <div class="name">
      {linkedName && <a href={`/${slugify(school, {lower: true})} `}><div class="teamcard_title">{school}</div></a>}
      {!linkedName && <div class="teamcard_title">{school}</div>}
      <div class="teamcard_mascot">
        {mascot}
        {(yearJoined > 1850) && <span> · {yearJoined}</span>}
        {(yearLeft) && <span> - {yearLeft}</span>}
      </div>
       
      
    </div>

    
</div>

<style>
    .teamcard {
          display: grid;
          grid-template-columns: fit-content(50px) 1fr;
          gap: 10px;
          align-items: center;
          grid-template-areas:
            "logo name";
          .logo {
            grid-area: logo;
            min-height: 40px;
            display: grid;
            place-items: center;
          }
          .name {
            grid-area: name;
            .teamcard_title {
              font-size: 1.3rem;
              font-weight: 500;
            }
            .teamcard_mascot {
              font-size: 1rem;
              font-weight: 400;
              font-variation-settings: "wdth" 90;
            }
          }
          
        }
</style>