---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import GameResult from '../components/GameResult.astro';
import slugify from 'slugify';
import { getActiveConferences, getPastConferences } from '../lib/db';

const seasons = (await getCollection('bowlseasons'))
  .sort((a, b) => parseInt(b.id) - parseInt(a.id));

let lastBowl = seasons[0].data.slice(-1);

const teams = await getCollection('teams', ({ data }) => {
  return data.classification !== null;
});

var conferences = getActiveConferences();
var past_conferences = getPastConferences();
console.log(past_conferences)

// Group conferences by classification
const conferencesByClassification = conferences.reduce((acc, conf) => {
  if (!acc[conf.classification]) {
    acc[conf.classification] = [];
  }
  acc[conf.classification].push(conf.name);
  return acc;
}, {});

const pageTitle = "Home |"
---

<BaseLayout pageTitle={pageTitle}>
  <div class="page-content">
    <h1>College Football Report</h1>
    <div class="topics">
      <div>
        <h2>Bowls</h2>
        <h3>Most Recent Bowl Game</h3>
        <GameResult game={lastBowl[0]} />
      </div>
      <div>
        <h2>Conferences</h2>
        
        {conferencesByClassification['fbs'] && (
          <>
            <h3>FBS</h3>
            <ul>
              {conferencesByClassification['fbs'].sort().map(conf => (
                <li><a href={`/conferences/${slugify(String(conf), {lower: true})}`}>{conf}</a></li>
              ))}
            </ul>
          </>
        )}
        
        {conferencesByClassification['fcs'] && (
          <>
            <h3>FCS</h3>
            <ul>
              {conferencesByClassification['fcs'].sort().map(conf => (
                <li><a href={`/conferences/${slugify(String(conf), {lower: true})}`}>{conf}</a></li>
              ))}
            </ul>
          </>
        )}
        
        {conferencesByClassification['ii'] && (
          <>
            <h3>Division 2</h3>
            <ul>
              {conferencesByClassification['ii'].sort().map(conf => (
                <li><a href={`/conferences/${slugify(String(conf), {lower: true})}`}>{conf}</a></li>
              ))}
            </ul>
          </>
        )}
        
        {conferencesByClassification['iii'] && (
          <>
            <h3>Division 3</h3>
            <ul>
              {conferencesByClassification['iii'].sort().map(conf => (
                <li><a href={`/conferences/${slugify(String(conf), {lower: true})}`}>{conf}</a></li>
              ))}
            </ul>
          </>
        )}

        <h2>Past Conferences</h2>
        <ul>
        {past_conferences.map(conf => (
         <li><a href={`/conferences/${slugify(String(conf.name), {lower: true})}`}>{conf.name}</a></li>
        ))}
        </ul>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .topics {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  width: 100%;
  gap: 40px;
  > div {
    flex-basis: 100%;
    flex: 1;
  }
}