---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import slugify from 'slugify';

const conferences = await getCollection('conferences', ({ data }) => {
  return data.current != null;
});

const pageTitle = "Conferences |";

---

<BaseLayout pageTitle={pageTitle}>
  <div class="page-content">
    <h1>Conferences</h1>
      {conferences.sort((a, b) => a.data.name.localeCompare(b.data.name)).map(conf => (
        <p><a href={`/new-conferences/${slugify(String(conf.data.name), {lower: true})}`}>{conf.data.name}</a></p>
      ))}
  </div>
</BaseLayout>