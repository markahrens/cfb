---
import { getAllConferenceSlugs, getCurrentTeamsByConference, getPastTeamsByConference } from '../../lib/db';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SimpleTeamCard from '../../components/SimpleTeamCard.astro'
import ConferenceMap from '../../components/ConferenceMap.jsx';

import slugify from 'slugify';


export const prerender = true

export async function getStaticPaths() {
  return getAllConferenceSlugs();
}

const { conferenceName, classification } = Astro.props;
const currentTeams = getCurrentTeamsByConference(conferenceName);
const pastTeams = getPastTeamsByConference(conferenceName);

console.log(pastTeams.length)
---

<BaseLayout pageTitle={`${conferenceName} |`}>
  <div class="page-content">
    <h1>{conferenceName}</h1>
    <div class="conference-page">
      <div class="teams">
        <div class="current">
          {currentTeams.length > 0 && (
            <>
            <h2>Current Teams</h2>
            {currentTeams.sort().map(team => (
                <SimpleTeamCard id={team.id} year_joined={team.year_joined}/>
            ))}
            </>
          )}
          
        </div>
        <div class="past">
          {pastTeams.length > 0 && (
            <>
              <h2>Past Teams</h2>
              {pastTeams.sort().map(team => (
                <div class="past-team">
                  <SimpleTeamCard id={team.id} />
                  <div>{team.year_joined} - {team.year_left}</div>
                </div>
              ))}
            </>
          )}
        </div>
      </div>
      <div class="map">
        <ConferenceMap client:only="react" teams={currentTeams}/>
      </div>
    </div>

  </div>
</BaseLayout>

<style is:global>
  .conference-page {
    display: grid;
    grid-template-columns: 1fr 2fr;
    column-gap: 40px;
  }
  .past-team {
    margin-bottom: 10px;
  }
   .map-container {
    height: 600px;
    width: 100%;
  }
  .name-tooltip {
    background-color: rgba(255,255,255,1);
    height: 16px;
    border: none !important;
    border-radius: 16px;
    font-weight: 500;
    box-shadow: none;
    opacity: 1 !important;
  }

  .leaflet-tooltip-top:before,
  .leaflet-tooltip-bottom:before,
  .leaflet-tooltip-left:before,
  .leaflet-tooltip-right:before {
    border: none !important
  }
</style>